# Copy this to .env and fill in your keys. Never commit .env.

# Anthropic (required)
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# YouTube Data API v3 (required)
# Get at: https://console.cloud.google.com -> APIs & Services -> Credentials
# Enable "YouTube Data API v3" first
YOUTUBE_API_KEY=AIza...

# Tavily Search API (required for web_search tool)
# Get at: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Model to use (optional, defaults to claude-sonnet-4-6)
# Options: claude-sonnet-4-6, claude-opus-4-8, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# Agent limits (optional)
MAX_STEPS=15
TOKEN_BUDGET=80000
