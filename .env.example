# Copy this to .env and fill in your keys. Never commit .env.

# Anthropic (required)
# Get at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# YouTube Data API v3 (required)
# Get at: https://console.cloud.google.com -> APIs & Services -> Credentials
# Enable "YouTube Data API v3" first
YOUTUBE_API_KEY=AIza...

# Tavily Search API (required for web_search tool)
# Get at: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Gemini model (optional)
GEMINI_MODEL=gemini-3.8-flash

# Agent limits (optional)
MAX_STEPS=15
TOKEN_BUDGET=80000

# Email delivery (optional — skip if you don't want email reports)
# Requires a Gmail App Password: myaccount.google.com/apppasswords
GMAIL_SENDER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_RECIPIENT=you@gmail.com
